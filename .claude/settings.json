{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "env": {
    "MCP_TIMEOUT": "120000"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/guard-paths.mjs",
            "timeout": 15,
            "statusMessage": "Comprobando rutas protegidas"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/data-layer-reminder.mjs",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
