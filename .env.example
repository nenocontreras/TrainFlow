# =============================================================================
# TrainFlow — Variables de entorno (sección 12 del SPEC)
# Copia este archivo a `.env.local` y rellena los valores.
# `.env.local` NUNCA se commitea.
# =============================================================================

# URL del proyecto Supabase.
# - Supabase Cloud: https://<project-ref>.supabase.co
# - Supabase local (`pnpm db:start`): http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_URL=

# Clave pública para el cliente (respeta RLS). Acepta el formato nuevo
# `sb_publishable_...` o la `anon` key JWT clásica. Dashboard > Settings > API.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clave secreta de servidor: BYPASSEA RLS. Solo server-side, jamás en el cliente
# ni con prefijo NEXT_PUBLIC_. Acepta `sb_secret_...` o la `service_role` JWT.
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# Tests de integración (tests/unit/rls.test.ts): reutilizan las 3 variables de
# arriba. Para apuntarlos a otra instancia, ponlas en `.env.test.local`.
# -----------------------------------------------------------------------------
