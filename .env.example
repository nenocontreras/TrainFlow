# =============================================================================
# TrainFlow — Variables de entorno (sección 12 del SPEC)
# Copia este archivo a `.env.local` y rellena los valores.
# `.env.local` NUNCA se commitea.
# =============================================================================

# URL pública del proyecto Supabase.
# - Supabase local (`pnpm db:start`): http://127.0.0.1:54321
# - Supabase Cloud: https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Clave anónima (segura para el cliente, respeta RLS).
# La imprime `supabase start`, o está en Dashboard > Project Settings > API.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clave service_role: BYPASSEA RLS. Solo en el servidor, jamás expuesta al cliente
# ni prefijada con NEXT_PUBLIC_. La imprime `supabase start`, o Dashboard > API.
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# Solo para tests de integración (tests/unit/rls.test.ts).
# Puedes ponerlas aquí o en `.env.test.local`. Apuntan a la instancia LOCAL.
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_SUPABASE_URL / NEXT_PUBLIC_SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY
# se reutilizan de arriba cuando trabajas contra Supabase local.
